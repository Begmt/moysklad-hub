# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://moysklad-hub.167-235-195-185.sslip.io
SESSION_SECRET=change-me-to-a-random-string

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moysklad_hub
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
