# MoySklad API
MS_API_BASE_URL=https://api.moysklad.ru/api/remap/1.2
MS_RATE_LIMIT_PER_200MS=3
# Optional. If empty, posted/applicable demands are synced.
MS_TARGET_DEMAND_STATE=

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
